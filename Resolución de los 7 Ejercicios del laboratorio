Ejercicio 1:
int SumScores(int[] scores)
{
    // +1 (asignación)
    int sum = 0;
    
    // +1 (init) + (N+1 comparaciones) + N incrementos
    for (int i = 0; i < scores.Length; i++)
    {
        // +2 (operación y asignación) + N
        sum += scores[i];

    }

    return sum; //+1
}

1 + 1 + (N+1) + N + 2 + N + 1

T(N) = 3N + 6
O(N) = N

