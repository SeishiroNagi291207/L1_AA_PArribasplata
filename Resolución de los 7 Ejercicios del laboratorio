int CalculateFinalDamage(int attack, int defense, float multiplier)
{
    // +1 (asignación) + 1(operación)
    int baseDamage = attack - defense;
    int finalDamage = (int)(baseDamage * multiplier); //+1 (asignación) + 1(operación)

    // +1 (operación)
    if (finalDamage < 0)
    {
        // +1 (asignación)
        finalDamage = 0;
    }
    // +1
    return finalDamage;
}

