int CountStrongerPairs(int[] powerLevels)
{
    // +1 (asignación)
    int count = 0;

    // +1 (init) + (N+1 comparaciones) + N incrementos
    for (int i = 0; i < powerLevels.Length; i++)
    {
         // +1 (init) + (N+1 comparaciones) + N incrementos
         for (int j = 0; j < powerLevels.Length; j++)
         {
                // N + 1(comparación) + N
             if (powerLevels[i] > powerLevels[i])
             {
                 count++; // N + 1 
             }
         }
    }
}

